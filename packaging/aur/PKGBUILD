# Maintainer: Glenn Barosen <glennbarosen@pm.me>
#
# This is the source of truth for the AUR package. The main repo's release
# workflow tags and publishes a GitHub Release automatically whenever
# workspace.package.version in Cargo.toml changes on main — there's no manual
# `git tag` step there. Publishing the *AUR* update is still manual: bump
# pkgver to match, refresh sha256sums (`updpkgsums`), regenerate .SRCINFO
# (`makepkg --printsrcinfo > .SRCINFO`), and push both to
# ssh://aur@aur.archlinux.org/emuhub-tui-bin.git — the AUR is a separate repo
# containing only PKGBUILD and .SRCINFO.

pkgname=emuhub-tui-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Terminal ROM browser and favourites manager for a Miyoo Mini+ running Onion OS, over SSH/SFTP"
arch=('x86_64' 'aarch64')
url="https://github.com/glennbarosen/emuhub-tui"
license=('MIT')
provides=('emuhub' 'emuhub-tui')
conflicts=('emuhub' 'emuhub-tui')

source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/emuhub-$pkgver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/emuhub-$pkgver-aarch64-unknown-linux-gnu.tar.gz")

sha256sums_x86_64=('b3643079d76da3283e297ad3a5a9988eedf9b6504f0be4f4b5dd4786ab5854a1')
sha256sums_aarch64=('ea7e725cf748c759a7aa3d3b2d9d563f67a4ae5b220277bfa21cba6497516c21')

package() {
	local _target
	case "$CARCH" in
		x86_64) _target="x86_64-unknown-linux-gnu" ;;
		aarch64) _target="aarch64-unknown-linux-gnu" ;;
	esac
	local _dir="$srcdir/emuhub-$pkgver-$_target"

	install -Dm755 "$_dir/emuhub" "$pkgdir/usr/bin/emuhub"
	install -Dm644 "$_dir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 "$_dir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
